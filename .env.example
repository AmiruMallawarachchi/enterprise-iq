# ═══════════════════════════════════════════════════════
#  EnterpriseIQ — Environment Variables Template
#  Copy this file to .env and fill in real values
#  NEVER commit .env to Git
# ═══════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────
ENVIRONMENT=development           # development | production
SECRET_KEY=generate-a-secure-key-here

# ── Database ─────────────────────────────────────────────
# Local (docker-compose):
DATABASE_URL=postgresql+asyncpg://admin:secret123@localhost:5432/enterprise_iq

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM APIs ──────────────────────────────────────────────
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# ── Vector Database ───────────────────────────────────────
VECTOR_STORE_BACKEND=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=enterprise-iq

# ── LangSmith (Observability) ─────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-key-here
LANGCHAIN_PROJECT=enterprise-iq

# ── Authentication ────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── File Storage ──────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
